# ============================================================
# WordPress connection - replace ALL placeholders before use
# ============================================================
WP_BASE_URL=http://localhost/wp
WP_USERNAME=admin
WP_APP_PASSWORD=replace_me

# ============================================================
# Site URLs (used for URL comparison and redirect candidates)
# ============================================================
LOCAL_SITE_URL=http://localhost/wp
PRODUCTION_SITE_URL=https://holasalta.com
PRODUCTION_DOMAIN=https://holasalta.com

# ============================================================
# Post defaults
# ============================================================
DEFAULT_POST_STATUS=publish
DEFAULT_AUTHOR_ID=1
DEFAULT_CATEGORY_ID=1

# ============================================================
# Write safety (NEVER enable without audit + dry-run)
# ALLOW_WORDPRESS_WRITES must be true to run migrate/migrate-range
# CONFIRM_PUBLISH_MODE must be true when DEFAULT_POST_STATUS=publish
# If DEFAULT_POST_STATUS=publish and CONFIRM_PUBLISH_MODE=false, migrate aborts.
# ============================================================
ALLOW_WORDPRESS_WRITES=false
CONFIRM_PUBLISH_MODE=false

# ============================================================
# Migration performance
# ============================================================
BATCH_SIZE=100
REQUEST_DELAY=0.2
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

# ============================================================
# Content formatting
# CONTENT_FORMAT_MODE: richcontent_first | contenttext_only
# richcontent_first: extract paragraphs from Wix richContent JSON,
#   split single long blocks with the sentence heuristic,
#   fall back to contentText heuristic if richContent is missing/empty.
# ============================================================
CONTENT_FORMAT_MODE=richcontent_first
CONTENT_PARAGRAPH_HEURISTIC=true
MAX_PARAGRAPH_CHARS=700
MIN_SENTENCES_PER_PARAGRAPH=1
MAX_SENTENCES_PER_PARAGRAPH=3

# ============================================================
# Image handling
# ============================================================
IMAGE_DOWNLOAD_TIMEOUT=60
IMAGE_DOWNLOAD_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125 Safari/537.36

NORMALIZE_IMAGES=true
NORMALIZE_ONLY_IF_NEEDED=true
RECOMPRESS_ALL_IMAGES=false
MAX_IMAGE_WIDTH=1400
MAX_IMAGE_FILESIZE_KB=250
JPEG_QUALITY=82
KEEP_ORIGINAL_IMAGES=false

# ============================================================
# Overnight run safety thresholds
# ============================================================
# CREATE_POST_IF_IMAGE_FAILS=true: create the post even if its image fails.
# STOP_ON_UNMAPPED_CATEGORY=true: block migration if any category has no mapping.
# STOP_ON_UNMAPPED_AUTHOR=false: use default author when no mapping found.
# MAX_POST_FAILURE_RATE: abort run if posts fail above this fraction (0.02 = 2%).
# MAX_IMAGE_FAILURE_RATE: log strong warning if images fail above this fraction.
# STOP_ON_CRITICAL_URL_ERRORS=true: block migration if invalid URLs are detected.
# ============================================================
CREATE_POST_IF_IMAGE_FAILS=true
MAX_POST_FAILURE_RATE=0.02
MAX_IMAGE_FAILURE_RATE=0.10
STOP_ON_CRITICAL_URL_ERRORS=true
STOP_ON_UNMAPPED_CATEGORY=true
STOP_ON_UNMAPPED_AUTHOR=false

# ============================================================
# Permalinks
# ============================================================
PERMALINK_STRUCTURE=/post/%postname%/
