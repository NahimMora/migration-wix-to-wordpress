WP_BASE_URL=http://holasalta.local
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx

LOCAL_SITE_URL=http://holasalta.local
PRODUCTION_SITE_URL=https://holasalta.com
PRODUCTION_DOMAIN=https://holasalta.com

DEFAULT_POST_STATUS=draft
DEFAULT_AUTHOR_ID=1
DEFAULT_CATEGORY_ID=1

BATCH_SIZE=100
REQUEST_DELAY=0.2
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=2

CREATE_POST_IF_IMAGE_FAILS=true

NORMALIZE_IMAGES=true
NORMALIZE_ONLY_IF_NEEDED=true
RECOMPRESS_ALL_IMAGES=false
MAX_IMAGE_WIDTH=1400
MAX_IMAGE_FILESIZE_KB=250
JPEG_QUALITY=82
KEEP_ORIGINAL_IMAGES=false

PERMALINK_STRUCTURE=/post/%postname%/
